# backend/.env — Use Pooler URI from Supabase. Wrong example:
#   DATABASE_URL=DATABASE_URL=postgresql://...   ← duplicate key inside value breaks parsing
# Right: value starts at postgresql+asyncpg:// only; encode password (&→%26, @→%40).
# Pooler user name is postgres.YOUR_PROJECT_REF (not postgres). Prefer pooler :6543 on WSL:
# direct db.<ref>.supabase.co :5432 is often IPv6-only → OSError errno 101 Network unreachable.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# web/.env.local
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=
